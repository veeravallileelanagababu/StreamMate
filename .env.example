# StreamMate Environment Variables Configuration

# -----------------------------------------------------------------------------
# 1. BACKEND SERVER CONFIGURATION (Render / Railway / VPS / Localhost)
# -----------------------------------------------------------------------------
# The port that server.js runs on (Render/Railway set this automatically)
PORT=3001

# Allowed origin for CORS (Set to your Vercel frontend URL in production)
# Example: FRONTEND_URL=https://streammate.vercel.app
FRONTEND_URL=

# -----------------------------------------------------------------------------
# 2. FRONTEND VITE CONFIGURATION (Vercel / Netlify / Localhost)
# -----------------------------------------------------------------------------
# The live URL of your deployed Express backend server.
# Leave blank for localhost development (uses Vite proxy).
# On Vercel dashboard: Add Environment Variable VITE_API_URL = https://your-backend.onrender.com
VITE_API_URL=
