# StreamMate Environment Variables Configuration

# -----------------------------------------------------------------------------
# 1. BACKEND SERVER CONFIGURATION
# -----------------------------------------------------------------------------
PORT=3001

# Allowed origin for CORS
FRONTEND_URL=

# -----------------------------------------------------------------------------
# 2. FRONTEND VITE CONFIGURATION
# -----------------------------------------------------------------------------
# The live URL of your deployed Express backend server.
# Leave blank for localhost development (uses Vite proxy).
VITE_API_URL=
